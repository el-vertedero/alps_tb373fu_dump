<?xml version="1.0" encoding="utf-8"?>
<!-- Debug: adb push pen_config.xml /system/etc/pen/pen_config.xml -->
<!-- Please configure according to the supporting pen
     of the actual project.  -->

<penservice>
    <market_names>
        <!-- Sheaffer B -->
        <market_name name="paladin">小新触控笔（第二代）</market_name>
        <!-- Sheaffer C -->
        <market_name name="paladin-c">小新触控笔（第二代）</market_name>
        <!-- Picasso, PRC, Consumer -->
        <market_name name="picasso">联想手写笔</market_name>
        <!-- Picasso Cost Down, PRC, Consumer  -->
        <market_name name="picasso-cd1">联想手写笔</market_name>

        <!-- Picasso, PRC, Commercial-1 -->
        <!-- <market_name name="picasso">联想启天触控笔Pro</market_name> -->
        <!-- Picasso Cost Down, PRC, Commercial-1 -->
        <!-- <market_name name="picasso-cd">联想启天触控笔Pro</market_name> -->

        <!-- Picasso, PRC, Commercial-2 -->
        <!-- <market_name name="picasso">联想昭阳触控笔Pro</market_name> -->
        <!-- Picasso Cost Down, PRC, Commercial-2 -->
        <!-- <market_name name="picasso-cd">联想昭阳触控笔Pro</market_name> -->

        <!-- Monet, PRC, Consumer  -->
        <market_name name="monet">联想手写笔</market_name>

        <!-- Picasso Cost Down, PRC, Commercial-1 -->
        <!-- <market_name name="monet">联想启天触控笔</market_name> -->

        <!-- Picasso Cost Down, PRC, Commercial-2 -->
        <!-- <market_name name="monet">联想昭阳触控笔</market_name> -->
    </market_names>
    <device_names>
        <!-- Sheaffer B -->
        <device_name name="paladin">Lenovo Precision Pen 3</device_name>
        <!-- Sheaffer C -->
        <device_name name="paladin-c">Lenovo Precision Pen 3</device_name>
        <!-- Picasso -->
        <device_name name="picasso">Lenovo Tab Pen Plus</device_name>
        <!-- Picasso Cost Down -->
        <device_name name="picasso-cd1">Lenovo Tab Pen Plus</device_name>
        <!-- Monet -->
        <device_name name="monet">Lenovo Tab Pen</device_name>
    </device_names>

    <settings_default_values>
        <!-- Quick Note -->
        <settings_default_value name="pen_set_quick_create_click_notes">1</settings_default_value>
        <!-- Screen Off Note -->
        <settings_default_value name="pen_set_quick_create_screenoff_notes">1</settings_default_value>
        <!-- Free Write -->
        <settings_default_value name="pen_set_freewrite_on">0</settings_default_value>
        <!-- Dynamic Palm Rejection -->
        <settings_default_value name="pen_dynamic_palm_rejection">1</settings_default_value>
        <!-- Pen Mode Disable UTouch  -->
        <settings_default_value name="key_pen_mode_disable_utouch">1</settings_default_value>
    </settings_default_values>
    <features>
        <!-- Easy Jot -->
        <feature name="easy_jot">1</feature>
        <!-- Anti-accidental Touch -->
        <feature name="pref_key_anti_accidental_touch">1</feature>
        <!-- Palm Rejection Custom Packages -->
        <feature name="pen_palm_rejection_custom_packages">1</feature>
        <!-- Dynamic Palm Rejection -->
        <feature name="pen_dynamic_palm_rejection">1</feature>
        <!-- Open free write by pen(Cap:Clicked, Bt:Paired(Firstly) -->
        <feature name="pen_activate_freewrite_on">0</feature>
    </features>
    <!-- More attributes will be added later... -->
</penservice>
